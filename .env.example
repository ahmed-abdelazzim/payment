# Runtime mode. Production startup refuses to silently create ./data/sarraf_ops.db.
NODE_ENV="development"
PORT="3000"

# SQLite is suitable only for local development and a temporary single-instance bridge.
# Production must set an explicit durable path while the PostgreSQL migration is completed.
DATABASE_FILE="./data/sarraf_ops.db"

# The outbox never sends to Telegram or customer webhook URLs unless BOTH switches are true.
# Use a separate `npm run worker:outbox` process in production. Embedded mode is only for a
# temporary, single-process bridge and must not be used by both web and worker processes.
OUTBOX_WORKER_ENABLED="false"
OUTBOX_DELIVERY_ENABLED="false"
OUTBOX_WORKER_EMBEDDED="false"
OUTBOX_POLL_INTERVAL_MS="10000"
OUTBOX_BATCH_SIZE="10"
OUTBOX_MAX_ATTEMPTS="8"
OUTBOX_LEASE_MS="90000"
OUTBOX_DELIVERY_TIMEOUT_MS="10000"
OUTBOX_ALLOW_INSECURE_HTTP="false"

# Financial-limit alerts. These values are percentages and must remain ordered 1..99.
LIMIT_ALERT_WARNING_PERCENT="80"
LIMIT_ALERT_CRITICAL_PERCENT="90"

# GEMINI_API_KEY: Required for optional Gemini AI features.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL of the platform (Used for email verification & invite links)
# In Railway: Set this to your generated domain (e.g. https://payment-production-xxxx.up.railway.app)
APP_URL="http://localhost:3000"

# ==========================================
# EMAIL DISPATCH CONFIGURATION (SMTP / Resend)
# ==========================================
# Option 1: Standard SMTP (e.g. Gmail App Password, Brevo, Mailgun, SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"Sarraf Ops\" <no-reply@sarrafops.com>"
SMTP_SECURE="false"

# Option 2: Resend API (Alternative)
# RESEND_API_KEY="re_your_api_key"

